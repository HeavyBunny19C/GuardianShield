echo Checking ETW orphan recovery...
findstr /c:"ERROR_ALREADY_EXISTS" "%PROJECT_ROOT%\src\service\GuardianA\src\guardian_a.cpp"
if %ERRORLEVEL% neq 0 (
    echo [FAIL] ETW orphan recovery not found!
    exit /b 1
) else (
    echo [PASS] ETW orphan recovery present
)

echo Checking SHA256File implementation...
findstr /c:"BCryptCreateHash" "%PROJECT_ROOT%\src\service\common\src\security.cpp"
if %ERRORLEVEL% neq 0 (
    echo [FAIL] SHA256File BCrypt implementation not found!
    exit /b 1
) else (
    echo [PASS] SHA256File BCrypt implementation present
)

echo.
echo ============================================================
echo VERIFICATION COMPLETE
echo Build: PASS
echo Tests: PASS
echo Security: PASS
