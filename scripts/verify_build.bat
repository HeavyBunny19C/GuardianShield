echo Warning count: %WARN_COUNT%
if %WARN_COUNT% gtr 0 (
    echo [WARN] %WARN_COUNT% compiler warnings found - review task-16-warnings.txt
) else (
    echo [PASS] Zero compiler warnings
)

REM Step 4: Run all tests
echo.
echo [STEP 4] Running all tests...
ctest --test-dir "%BUILD_DIR%" --config Release --output-on-failure 2>&1 | tee "%LOG_DIR%\task-16-test-results.txt"
if %ERRORLEVEL% neq 0 (
    echo [FAIL] Some tests failed - review task-16-test-results.txt
    exit /b 1
)
echo [PASS] All tests passed

REM Step 5: Count test results
echo.
echo [STEP 5] Test summary...
findstr "tests passed" "%LOG_DIR%\task-16-test-results.txt"
