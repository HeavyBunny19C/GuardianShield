@echo off
REM ============================================================
REM GuardianShield V1 Build + Test Verification Script
REM Generated by Atlas (Sisyphus orchestrator)
REM Run this on the target Windows machine with VS2022 installed
REM ============================================================

setlocal enabledelayedexpansion

set PROJECT_ROOT=%~dp0..
set BUILD_DIR=%PROJECT_ROOT%\build
set LOG_DIR=%PROJECT_ROOT%\.sisyphus\evidence

echo ============================================================
echo GuardianShield V1 Build + Test Verification
echo Project: %PROJECT_ROOT%
echo Time: %DATE% %TIME%
echo ============================================================

REM Create evidence directory
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

REM Step 1: CMake Configure
echo.
echo [STEP 1] CMake Configure...
cmake -B "%BUILD_DIR%" -G "Visual Studio 17 2022" -A x64 -DBUILD_TESTS=ON -DBUILD_TOOLS=ON 2>&1 | tee "%LOG_DIR%\task-16-cmake-configure.txt"
if %ERRORLEVEL% neq 0 (
    echo [FAIL] CMake configure failed
    exit /b 1
)
echo [PASS] CMake configure succeeded

REM Step 2: Build Release
echo.
echo [STEP 2] Building Release...
cmake --build "%BUILD_DIR%" --config Release 2>&1 | tee "%LOG_DIR%\task-16-build.txt"
if %ERRORLEVEL% neq 0 (
    echo [FAIL] Build failed
    exit /b 1
)
echo [PASS] Build succeeded

REM Step 3: Check for warnings
echo.
echo [STEP 3] Checking for /W4 warnings...
findstr /i "warning C" "%LOG_DIR%\task-16-build.txt" > "%LOG_DIR%\task-16-warnings.txt"
