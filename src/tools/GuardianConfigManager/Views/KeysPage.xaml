<UserControl x:Class="GuardianConfigManager.Views.KeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GuardianConfigManager.Views">
    <UserControl.Resources>
        <local:PcrIndicesConverter x:Key="PcrIndicesConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="密钥与加密" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="TPM" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="0" Content="启用"
                          IsChecked="{Binding Config.Keys.Tpm.Enabled}"
                          Margin="0,4,0,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="PCR 索引 (逗号分隔)" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Config.Keys.Tpm.PcrIndices, UpdateSourceTrigger=LostFocus, Converter={StaticResource PcrIndicesConverter}}"
                         Margin="0,4,0,8"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="加密" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="算法" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          SelectedValue="{Binding Config.Keys.Encryption.Algorithm}"
                          SelectedValuePath="Content"
                          Margin="0,4,0,8">
                    <ComboBoxItem Content="AES-256-GCM"/>
                    <ComboBoxItem Content="AES-256-CBC"/>
                    <ComboBoxItem Content="ChaCha20-Poly1305"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="密钥轮换天数" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Config.Keys.Encryption.KeyRotationDays, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
