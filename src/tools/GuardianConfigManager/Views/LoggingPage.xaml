<UserControl x:Class="GuardianConfigManager.Views.LoggingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="日志配置" Style="{StaticResource SectionHeader}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="路径" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.Logging.Path, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="格式" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding Config.Logging.Format}"
                          SelectedValuePath="Content" Margin="0,4,0,8">
                    <ComboBoxItem Content="json"/>
                    <ComboBoxItem Content="text"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="保留天数" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.Logging.RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="按天轮转" Style="{StaticResource FieldLabel}"/>
                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Config.Logging.DailyRotation}"
                          Content="每天生成新的日志文件"
                          VerticalAlignment="Center" Margin="0,4,0,8"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
