<UserControl x:Class="GuardianConfigManager.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="系统配置" Style="{StaticResource SectionHeader}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.System.Version, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Config Version" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.System.ConfigVersion, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Log Level" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" SelectedValue="{Binding Config.System.LogLevel}"
                          SelectedValuePath="Content" Margin="0,4,0,8">
                    <ComboBoxItem Content="DEBUG"/>
                    <ComboBoxItem Content="INFO"/>
                    <ComboBoxItem Content="WARN"/>
                    <ComboBoxItem Content="ERROR"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Log Path" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.System.LogPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
