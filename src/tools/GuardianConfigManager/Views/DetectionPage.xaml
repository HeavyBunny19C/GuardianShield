<UserControl x:Class="GuardianConfigManager.Views.DetectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="威胁检测阈值" Style="{StaticResource SectionHeader}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Alert Timeout (秒)" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.Detection.AlertTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,16"/>
            </Grid>

            <TextBlock Text="留空或填 0 = 不限制该类行为" FontSize="12" Foreground="#9AA0A6"
                       Margin="0,0,0,12"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tier 1 -->
            <GroupBox Grid.Column="0" Header="Tier 1（保护协议）" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="file_write" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileWriteCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileWriteWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="file_compress" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileCompressCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileCompressWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="file_delete" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileDeleteCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileDeleteWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="file_network_transfer" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileNetworkTransferCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier1.FileNetworkTransferWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="data_transfer_mb" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.Detection.Thresholds.Tier1.DataTransferMb, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" HorizontalAlignment="Left" Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="process_termination_count" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Config.Detection.Thresholds.Tier1.ProcessTerminationCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" HorizontalAlignment="Left" Margin="0,4,0,4"/>
                </Grid>
            </GroupBox>

            <!-- Tier 2 -->
            <GroupBox Grid.Column="2" Header="Tier 2（紧急协议）" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="file_write" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileWriteCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileWriteWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="file_compress" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileCompressCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileCompressWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="file_delete" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileDeleteCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileDeleteWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="file_network_transfer" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileNetworkTransferCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="count" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6" Margin="0,0,12,0"/>
                        <TextBox Width="60" Text="{Binding Config.Detection.Thresholds.Tier2.FileNetworkTransferWindowSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4"/>
                        <TextBlock Text="window" VerticalAlignment="Center" FontSize="11" Foreground="#9AA0A6"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="data_transfer_mb" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.Detection.Thresholds.Tier2.DataTransferMb, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" HorizontalAlignment="Left" Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="process_termination_count" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Config.Detection.Thresholds.Tier2.ProcessTerminationCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" HorizontalAlignment="Left" Margin="0,4,0,4"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
