<UserControl x:Class="GuardianConfigManager.Views.CommunicationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="IPC 通信配置" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="命名管道 (Named Pipe)" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="0" Content="启用"
                          IsChecked="{Binding Config.Communication.NamedPipe.Enabled}"
                          Margin="0,4,0,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="超时 (ms)" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Config.Communication.NamedPipe.TimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="共享内存 (Shared Memory)" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <Grid Margin="0,4,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="0" Content="启用"
                          IsChecked="{Binding Config.Communication.SharedMemory.Enabled}"
                          Margin="0,4,0,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="大小 (KB)" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Config.Communication.SharedMemory.SizeKb, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="TCP" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" Grid.Column="0" Content="启用"
                          IsChecked="{Binding Config.Communication.Tcp.Enabled}"
                          Margin="0,4,0,8" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="端口基数" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Config.Communication.Tcp.PortBase, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,8"/>
                <CheckBox Grid.Row="2" Grid.Column="0" Content="TLS"
                          IsChecked="{Binding Config.Communication.Tcp.Tls}"
                          Margin="0,4,0,8" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
