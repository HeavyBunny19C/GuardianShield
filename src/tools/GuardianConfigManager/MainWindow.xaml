<Window x:Class="GuardianConfigManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuardianConfigManager.ViewModels"
        xmlns:v="clr-namespace:GuardianConfigManager.Views"
        Title="GuardianShield 配置管理工具" Width="1050" Height="720"
        WindowStartupLocation="CenterScreen" Background="#FAFAFA">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock Text="GuardianShield" FontSize="16" FontWeight="Bold" Foreground="#1A73E8"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="配置管理工具" FontSize="14" VerticalAlignment="Center" Foreground="#5F6368"
                           Margin="0,0,24,0"/>
                <Button Content="打开配置文件" Command="{Binding OpenConfigCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="保存配置文件" Command="{Binding SaveConfigCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,16,0"/>
                <Button Content="打开授权清单" Command="{Binding OpenAuthCommand}" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="保存授权清单" Command="{Binding SaveAuthCommand}" Style="{StaticResource PrimaryButton}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ConfigFilePath}" FontSize="11"
                           Foreground="#9AA0A6" VerticalAlignment="Center" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
            </DockPanel>
        </Border>

        <!-- Main content: nav + pages -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left nav -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList" SelectedIndex="{Binding SelectedNavIndex}" BorderThickness="0"
                         Background="Transparent" ItemContainerStyle="{StaticResource NavButton}">
                    <ListBoxItem Content="系统配置"/>
                    <ListBoxItem Content="威胁检测阈值"/>
                    <ListBoxItem Content="保护目录"/>
                    <ListBoxItem Content="进程白名单"/>
                    <ListBoxItem Content="环境授权"/>
                    <ListBoxItem Content="管理员设置"/>
                    <ListBoxItem Content="日志配置"/>
                    <ListBoxItem Content="通信配置"/>
                    <ListBoxItem Content="紧急协议"/>
                    <ListBoxItem Content="密钥与加密"/>
                    <ListBoxItem Content="授权清单"/>
                </ListBox>
            </Border>

            <!-- Right content area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="0">
                                    <Setter Property="Content"><Setter.Value><v:SystemPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="1">
                                    <Setter Property="Content"><Setter.Value><v:DetectionPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="2">
                                    <Setter Property="Content"><Setter.Value><v:ProtectionPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="3">
                                    <Setter Property="Content"><Setter.Value><v:WhitelistPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="4">
                                    <Setter Property="Content"><Setter.Value><v:AuthorizationPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="5">
                                    <Setter Property="Content"><Setter.Value><v:AdminPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="6">
                                    <Setter Property="Content"><Setter.Value><v:LoggingPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="7">
                                    <Setter Property="Content"><Setter.Value><v:CommunicationPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="8">
                                    <Setter Property="Content"><Setter.Value><v:EmergencyPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="9">
                                    <Setter Property="Content"><Setter.Value><v:KeysPage/></Setter.Value></Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="10">
                                    <Setter Property="Content"><Setter.Value><v:AuthListPage/></Setter.Value></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#5F6368"/>
        </Border>
    </Grid>
</Window>
