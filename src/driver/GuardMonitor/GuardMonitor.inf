;
; GuardMonitor.inf - GuardianShield Process Monitor Driver
;

[Version]
Signature   = "$Windows NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
DriverVer   = 03/02/2026,1.0.0.0
CatalogFile = GuardMonitor.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir            = 12     ; %windir%\system32\drivers
GuardMonitor.DriverFiles  = 12

[DefaultInstall.ntamd64]
OptionDesc  = %ServiceDescription%
CopyFiles   = GuardMonitor.DriverFiles

[DefaultInstall.ntamd64.Services]
AddService  = %ServiceName%,,GuardMonitor.Service

[DefaultUninstall.ntamd64]
DelFiles   = GuardMonitor.DriverFiles

[DefaultUninstall.ntamd64.Services]
DelService = %ServiceName%,0x200

;
; Service
;
[GuardMonitor.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys
ServiceType      = 1              ; SERVICE_KERNEL_DRIVER
StartType        = 3              ; SERVICE_DEMAND_START
ErrorControl     = 1              ; SERVICE_ERROR_NORMAL

[GuardMonitor.DriverFiles]
%DriverName%.sys

;
; Source
;
[SourceDisksFiles]
GuardMonitor.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

;
; String Section
;
[Strings]
ProviderString     = "GuardianShield"
ServiceName        = "GuardMonitor"
ServiceDescription = "GuardianShield Process and Image Load Monitor"
DriverName         = "GuardMonitor"
DiskId1            = "GuardMonitor Installation Disk"
