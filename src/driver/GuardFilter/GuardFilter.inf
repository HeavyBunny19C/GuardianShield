;
; GuardFilter.inf - GuardianShield File System Minifilter Driver
;

[Version]
Signature   = "$Windows NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ProviderString%
DriverVer   = 03/02/2026,1.0.0.0
CatalogFile = GuardFilter.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir          = 12     ; %windir%\system32\drivers
GuardFilter.DriverFiles = 12

[DefaultInstall.ntamd64]
OptionDesc  = %ServiceDescription%
CopyFiles   = GuardFilter.DriverFiles

[DefaultInstall.ntamd64.Services]
AddService  = %ServiceName%,,GuardFilter.Service

[DefaultUninstall.ntamd64]
DelFiles   = GuardFilter.DriverFiles

[DefaultUninstall.ntamd64.Services]
DelService = %ServiceName%,0x200

;
; Service
;
[GuardFilter.Service]
DisplayName      = %ServiceName%
Description      = %ServiceDescription%
ServiceBinary    = %12%\%DriverName%.sys
Dependencies     = FltMgr
ServiceType      = 2              ; SERVICE_FILE_SYSTEM_DRIVER
StartType        = 3              ; SERVICE_DEMAND_START
ErrorControl     = 1              ; SERVICE_ERROR_NORMAL
LoadOrderGroup   = "FSFilter Activity Monitor"
AddReg           = GuardFilter.AddRegistry

[GuardFilter.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\"%Instance1.Name%,"Altitude",0x00000000,%Instance1.Altitude%
HKR,"Instances\"%Instance1.Name%,"Flags",0x00010001,%Instance1.Flags%

[GuardFilter.DriverFiles]
%DriverName%.sys

;
; Source
;
[SourceDisksFiles]
GuardFilter.sys = 1,,

[SourceDisksNames]
1 = %DiskId1%,,,

;
; String Section
;
[Strings]
ProviderString     = "GuardianShield"
ServiceName        = "GuardFilter"
ServiceDescription = "GuardianShield File System Protection Filter"
DriverName         = "GuardFilter"
DiskId1            = "GuardFilter Installation Disk"
DefaultInstance    = "GuardFilter Instance"
Instance1.Name     = "GuardFilter Instance"
Instance1.Altitude = "370100"
Instance1.Flags    = 0x0
